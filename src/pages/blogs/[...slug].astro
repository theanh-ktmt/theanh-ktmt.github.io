---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: posts
        .filter((p) => p.id !== post.id && !p.data.sample)
        .map((p) => ({
          post: p,
          score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
        }))
        .sort(
          (a, b) =>
            b.score - a.score ||
            b.post.data.date.valueOf() - a.post.data.date.valueOf(),
        )
        .filter((p) => p.score > 0 || post.data.sample)
        .slice(0, 2)
        .map((p) => p.post),
    },
  }));
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} related={related}>
  <Content />
</BlogPost>
