---
import BaseLayout from "../layouts/BaseLayout.astro";
import CVProject from "../components/CVProject.astro";
import { cv } from "../data/cv";
const sections = [
  ["experience", "Work"],
  ["about", "Education"],
  ["skills", "Skills"],
  ["publications", "Publications"],
  ["honors", "Honors"],
  ["activities", "Activities"],
  ["languages", "Languages"],
  ["references", "References"],
];
---

<BaseLayout
  title="Experience - The Anh Tran"
  description="The Anh Tran's online CV: Senior Deep Learning Algorithms Engineer at NVIDIA, work history, education, technical skills, publications, honors, and activities. Updated 18 November 2026."
>
  <div class="wrap cv-page">
    <header class="cv-header">
      <div>
        <h1>
          Experience<span class="accent">.</span>
        </h1>
        <p class="cv-current-role">{cv.role} at NVIDIA</p>
        <p class="cv-location">{cv.location}</p>
      </div>
      <div class="cv-actions">
        <a
          class="button primary"
          href={cv.resumeUrl}
          download="The-Anh-Tran-CV-2026-11-18.pdf"
        >
          Download CV <span aria-hidden="true">&#8599;</span>
        </a>
        <p class="cv-updated">
          Last updated: <time datetime={cv.updated}>{cv.updatedLabel}</time>
        </p>
      </div>
    </header>
    <div class="cv-layout">
      <div class="cv-main">
        <section
          id="experience"
          class="cv-section"
          aria-labelledby="work-heading"
        >
          <h2 id="work-heading">Work experience</h2>
          {cv.work.map((job) => (
            <article class="cv-entry">
              <header class="cv-entry-header">
                <div>
                  <h3>{job.company}</h3>
                  <p class="cv-job-role">{job.role}</p>
                </div>
                <div class="cv-entry-meta">
                  <p>
                    {job.start} &ndash; {job.end}
                  </p>
                  <p>{job.location}</p>
                </div>
              </header>
              {job.projects.map((project) => (
                <CVProject project={project} />
              ))}
            </article>
          ))}
        </section>
        <section
          id="about"
          class="cv-section"
          aria-labelledby="education-heading"
        >
          <h2 id="education-heading">Education</h2>
          {cv.education.map((education) => (
            <article class="cv-entry">
              <header class="cv-entry-header">
                <div>
                  <h3>{education.institution}</h3>
                  <p class="cv-job-role">{education.qualification}</p>
                </div>
                <div class="cv-entry-meta">
                  <p>{education.period}</p>
                  <p>{education.location}</p>
                </div>
              </header>
              <ul class="cv-bullets">
                {education.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </article>
          ))}
        </section>
        <section
          id="skills"
          class="cv-section"
          aria-labelledby="skills-heading"
        >
          <h2 id="skills-heading">Technical skills</h2>
          <dl class="cv-skills">
            {cv.skillGroups.map((group) => (
              <div>
                <dt>{group.name}</dt>
                <dd>{group.values.join(" · ")}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section
          id="publications"
          class="cv-section"
          aria-labelledby="publications-heading"
        >
          <h2 id="publications-heading">Publications</h2>
          {cv.publications.map((publication) => (
            <article class="cv-entry">
              <p class="cv-venue">{publication.venue}</p>
              <h3 class="cv-paper-title">
                <a href={publication.href}>
                  {publication.title} <span aria-hidden="true">&#8599;</span>
                </a>
              </h3>
              <p class="cv-authors">{publication.authors}</p>
              <p class="publication-links">
                <a href={publication.href}>Paper &#8599;</a>
                <a href={publication.code}>Code &#8599;</a>
              </p>
            </article>
          ))}
        </section>
        <section
          id="honors"
          class="cv-section"
          aria-labelledby="honors-heading"
        >
          <h2 id="honors-heading">Honors &amp; recognitions</h2>
          <ul class="cv-records">
            {cv.honors.map((honor) => (
              <li>
                <div>
                  <h3>{honor.title}</h3>
                  <p>{honor.organization}</p>
                  {"detail" in honor && honor.detail && <p>{honor.detail}</p>}
                </div>
                <span class="cv-record-date">{honor.period}</span>
              </li>
            ))}
          </ul>
        </section>
        <section
          id="activities"
          class="cv-section"
          aria-labelledby="activities-heading"
        >
          <h2 id="activities-heading">Activities</h2>
          <ul class="cv-records">
            {cv.activities.map((activity) => (
              <li>
                <div>
                  <h3>{activity.title}</h3>
                  <p>{activity.organization}</p>
                </div>
                <span class="cv-record-date">{activity.period}</span>
              </li>
            ))}
          </ul>
        </section>
        <section
          id="languages"
          class="cv-section"
          aria-labelledby="languages-heading"
        >
          <h2 id="languages-heading">Languages</h2>
          <dl class="cv-skills">
            {cv.languages.map((language) => (
              <div>
                <dt>{language.name}</dt>
                <dd>{language.detail}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section
          id="references"
          class="cv-section"
          aria-labelledby="references-heading"
        >
          <h2 id="references-heading">References</h2>
          <article class="cv-entry cv-reference">
            <h3>{cv.reference.name}</h3>
            <p>{cv.reference.qualification}</p>
            <p>{cv.reference.position}</p>
            <a href={`mailto:${cv.reference.email}`}>{cv.reference.email}</a>
          </article>
        </section>
      </div>
      <nav class="cv-section-nav" aria-label="CV sections">
        <ul>
          {sections.map(([id, label]) => (
            <li>
              <a href={`#${id}`}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</BaseLayout>
