---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cv } from "../data/cv";
import autoResearchImage from "../../public/assets/autoresearch.png";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import nvidiaSymbol from "../../public/assets/companies/nvidia-symbol.png";
import hustLogo from "../../public/assets/companies/hust.jpg";
import { Image } from "astro:assets";
import portrait from "../../public/assets/profile-pic.png";
import morehImage from "../../public/assets/project-1.png";
import mbImage from "../../public/assets/project-2.png";
import asillaImage from "../../public/assets/asilla-product.png";
const projects = [
  {
    name: "NVIDIA AutoResearch",
    category: "LLM AGENTS / WORLD MODELS",
    problem: "Autonomous inference optimization for Cosmos world models.",
    work: "Built a reliable agent loop with deterministic verification and guardrails for unattended multi-day campaigns.",
    result:
      "Cosmos3-Nano: Sim-Auto +415% on vLLM-Omni (4 H200 GPUs). On SGLang (1 H200 GPU): Sim-Auto +103%, Sim-Bimanual +71%, Sim-Transfer +49%, and Transfer-Auto +17%.",
    label: "Confidential project",
    image: autoResearchImage,
    alt: "Loop Engineering illustration showing planner, reasoner, retriever, evaluator, analyzer, and executor agents in a continuous loop.",
  },
  {
    name: "Moreh vLLM",
    category: "LLM INFERENCE / AMD GPUs",
    problem: "High-performance LLM serving on AMD hardware.",
    work: "Optimized LLM inference with vLLM on AMD GPUs.",
    result:
      "20–70% faster than leading engines on AMD hardware. Achieved 90% of NVIDIA performance. Contributed to $15.6M in enterprise contracts.",
    href: "https://moreh.io/moreh-vllm/",
    label: "Explore Moreh vLLM",
    image: morehImage,
    alt: "Moreh vLLM project",
  },
  {
    name: "MB Chatbot",
    category: "RAG / ENTERPRISE AI",
    problem:
      "Enterprise customer service across a large document collection at MB Bank.",
    work: "Indexed 60,000+ documents using Milvus & Neo4j.",
    result: "Served 1,000+ users with 81% accuracy and <7s response time.",
    label: "Confidential project",
    image: mbImage,
    alt: "MB Chatbot project",
  },
  {
    name: "Ajikame",
    category: "COMPUTER VISION / MEDICAL AI",
    problem: "Medical behavior detection for Hananoki Hospital.",
    work: "Built respiratory failure and epileptic seizure detection.",
    result:
      "70% accuracy for respiratory failure detection; 65% recall and <30s alert latency for epileptic seizure detection.",
    href: "https://en.asilla.com/services/ai-security-asilla",
    label: "Explore Asilla",
    image: asillaImage,
    alt: "Asilla action recognition: video input, pose estimation, time-series analysis, and fall detection",
  },
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${Astro.site}#person`,
      name: "The Anh Tran",
      url: Astro.site?.href,
      jobTitle: "Senior Deep Learning Algorithms Engineer",
      worksFor: {
        "@type": "Organization",
        name: "NVIDIA",
        url: "https://www.nvidia.com/",
      },
      email: "mailto:trantheanh.ktmt@gmail.com",
      image: new URL("/assets/profile-pic.png", Astro.site).href,
      sameAs: [
        "https://github.com/theanh-ktmt",
        "https://www.linkedin.com/in/theanh-ktmt/",
      ],
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Hanoi University of Science and Technology",
      },
      knowsAbout: [
        "Agent Loop",
        "Cosmos world models",
        "LLM inference",
        "GPU performance",
        "Distributed AI systems",
        "CUDA",
        "vLLM",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      name: "The Anh Tran",
      url: Astro.site?.href,
      inLanguage: "en",
      publisher: { "@id": `${Astro.site}#person` },
    },
  ],
};
---

<BaseLayout
  title="The Anh Tran - Personal Page"
  description="The Anh Tran, Senior Deep Learning Algorithms Engineer at NVIDIA. Building agent loops to automatically optimize Cosmos world models; previously optimizing vLLM inference on AMD GPUs."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
  />
  <div class="home">
    <div class="wrap">
      <section id="profile" class="hero">
        <div class="hero-copy">
          <h1>
            The Anh Tran<span class="accent">.</span>
          </h1>
          <p class="hero-role">
            Senior Deep Learning Algorithms Engineer at NVIDIA
          </p>
          <div class="affiliations" aria-label="Company and education">
            <a
              class="affiliation"
              href="https://www.nvidia.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Image
                src={nvidiaSymbol}
                alt=""
                width={42}
                height={29}
                widths={[84, 126]}
                format="webp"
                class="affiliation-symbol"
              />
              <span>NVIDIA</span>
            </a>
            <a
              class="affiliation affiliation-school"
              href="/experience.html#about"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Image
                src={hustLogo}
                alt=""
                width={30}
                height={45}
                widths={[60, 90]}
                format="webp"
                class="affiliation-school-logo"
              />
              <span>Hanoi University of Science and Technology</span>
            </a>
          </div>
          <p class="hero-intro">
            Building agent loops to automatically optimize Cosmos world models.
            Previously focused on optimizing LLM inference with vLLM on AMD
            GPUs.
          </p>
          <div class="hero-links">
            <a class="button primary" href="#projects">
              Selected work <span aria-hidden="true">↘</span>
            </a>
            <a
              class="text-link"
              href={cv.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download résumé <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-portrait">
          <Image
            src={portrait}
            alt="The Anh Tran"
            width={340}
            height={340}
            widths={[224, 340, 600]}
            sizes="(max-width: 540px) 112px, (max-width: 800px) 160px, 340px"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </section>
    </div>
    <SkillsMarquee />
    <div class="wrap">
      <section id="projects" class="home-section">
        <header class="section-heading">
          <div>
            <h2>Selected projects</h2>
          </div>
        </header>
        {projects.map((p) => (
          <article class="project-row">
            <div class="project-identity">
              <h3>{p.name}</h3>
              <a
                class="project-image-link"
                href={p.href || "/contact.html"}
                aria-label={p.href ? p.label : "Contact me about MB Chatbot"}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Image
                  src={p.image}
                  alt={p.alt}
                  loading="lazy"
                  decoding="async"
                  width={640}
                  height={360}
                  widths={[360, 640, 960]}
                  sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 800px) 40vw, 360px"
                  format="webp"
                  fit="cover"
                  quality={85}
                />
              </a>
            </div>
            <div class="project-details">
              <dl>
                <div>
                  <dt class="sr-only">THE PROBLEM</dt>
                  <dd>{p.problem}</dd>
                </div>
                <div>
                  <dt class="sr-only">MY CONTRIBUTION</dt>
                  <dd>{p.work}</dd>
                </div>
                <div>
                  <dt class="sr-only">THE RESULT</dt>
                  <dd>{p.result}</dd>
                </div>
              </dl>
              {p.href ? (
                <a
                  class="text-link"
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.label} ↗
                </a>
              ) : (
                <span class="muted mono">{p.label}</span>
              )}
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>
  <script is:inline>
    const moved = {
      "#experience": "/experience.html#experience",
      "#about": "/experience.html#about",
      "#honors": "/experience.html#honors",
      "#activities": "/experience.html#activities",
      "#writing": "/blogs.html",
      "#publications": "/experience.html#publications",
      "#contact": "/contact.html",
    };
    if (moved[location.hash]) location.replace(moved[location.hash]);
  </script>
</BaseLayout>
