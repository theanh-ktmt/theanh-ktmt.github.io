---
import BaseLayout from "./BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { dimensions } from "../utils/images";
import "katex/dist/katex.min.css";
import katexMain from "katex/dist/fonts/KaTeX_Main-Regular.woff2?url";
import katexMath from "katex/dist/fonts/KaTeX_Math-Italic.woff2?url";
const { post, headings, related } = Astro.props;
const { title, description, date, tags, readTime, hero, heroAlt, sample } =
  post.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`/og/${post.id}.png`, Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": canonical + "#article",
      headline: title,
      description,
      datePublished: date.toISOString(),
      author: {
        "@type": "Person",
        "@id": `${Astro.site}#person`,
        name: "The Anh Tran",
        url: Astro.site?.href,
      },
      publisher: {
        "@type": "Person",
        name: "The Anh Tran",
        url: Astro.site?.href,
      },
      image: [image],
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en",
      keywords: tags.join(", "),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: Astro.site?.href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Writing",
          item: new URL("/blogs.html", Astro.site).href,
        },
        { "@type": "ListItem", position: 3, name: title, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${title} — The Anh Tran`}
  description={description}
  ogType="article"
  ogImage={`/og/${post.id}.png`}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author" content={Astro.site?.href} />
    <link
      rel="preload"
      href={katexMain}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={katexMath}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <div class="wrap post-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/blogs.html">Writing</a>
        </li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <header class="post-header">
      <div class="post-meta">
        {tags.map((tag: string) => (
          <a href={`/blogs.html?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
      <h1>{title}</h1>
      <p class="post-deck">{description}</p>
      <div class="byline">
        <a href="/experience.html#about">The Anh Tran</a>
        <span aria-hidden="true">/</span>
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })}
        </time>
        <span aria-hidden="true">/</span>
        <span>{readTime}</span>
      </div>
    </header>
    <div class="article-layout">
      <div class="article-main">
        {sample && (
          <p class="sample-notice">
            SAMPLE POST / A demonstration of this site’s publishing features.
          </p>
        )}
        {!sample && (
          <img
            class="post-hero"
            src={hero}
            alt={heroAlt || title}
            {...dimensions(hero)}
            fetchpriority="high"
            decoding="async"
          />
        )}
        <article class="prose" aria-label={title}>
          <slot />
        </article>
        <div class="post-bottom">
          <div class="share-row">
            <p>Useful to your team? Pass it along.</p>
            <button type="button" data-copy-link>
              Copy link ↗
            </button>
          </div>
        </div>
        {related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <p class="eyebrow">KEEP READING</p>
            <h2 id="related-title">Related writing.</h2>
            {related.map((p: any) => (
              <PostRow post={p} />
            ))}
          </section>
        )}
        <section class="comments" aria-labelledby="comments-title">
          <h2 id="comments-title">Discussion.</h2>
          <p>
            Questions, corrections, or a different perspective? Join with
            GitHub.
          </p>
          <details id="comments-disclosure">
            <summary>Load comments from GitHub</summary>
            <div class="giscus-container" id="giscus-container"></div>
          </details>
        </section>
      </div>
      <TableOfContents headings={headings} />
      <TableOfContents headings={headings} mobile />
    </div>
  </div>
</BaseLayout>
