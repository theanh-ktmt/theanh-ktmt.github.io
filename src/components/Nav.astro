---
const experience = Astro.url.pathname === "/experience.html";
const blog = Astro.url.pathname.startsWith("/blogs");
const contact = Astro.url.pathname === "/contact.html";
---

<header class="site-header wrap">
  <a class="wordmark" href="/" target="_blank" rel="noopener noreferrer">
    <span class="brand-mark" aria-hidden="true">
      ta<span>.</span>
    </span>{" "}
    The Anh Tran
  </a>
  <nav aria-label="Main navigation">
    <a href="/#projects" target="_blank" rel="noopener noreferrer">
      Work
    </a>
    <a
      class="nav-experience"
      href="/experience.html"
      aria-current={experience ? "page" : undefined}
      target="_blank"
      rel="noopener noreferrer"
    >
      Experience
    </a>
    <a
      href="/blogs.html"
      aria-current={blog ? "page" : undefined}
      target="_blank"
      rel="noopener noreferrer"
    >
      Writing
    </a>
    <a
      class="nav-contact"
      href="/contact.html"
      aria-current={contact ? "page" : undefined}
      target="_blank"
      rel="noopener noreferrer"
    >
      Contact
    </a>
    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Switch color theme"
      title="Switch color theme"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
      </svg>
    </button>
  </nav>
</header>
