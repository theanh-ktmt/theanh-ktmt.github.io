---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "./PostRow.astro";
const { page = 1 } = Astro.props;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const size = 6;
const pages = Math.ceil(posts.length / size);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const visible = posts.slice((page - 1) * size, page * size);
const pageUrl = (n: number) =>
  n === 1 ? "/blogs.html" : `/blogs/page/${n}.html`;
---

<BaseLayout
  title={`Writing${page > 1 ? ` - Page ${page}` : ""} - The Anh Tran`}
  description={`Technical writing on agent loops, world models, LLM inference, and GPU performance by The Anh Tran.${page > 1 ? ` Archive page ${page}.` : ""}`}
>
  <div class="wrap archive" data-archive data-page={page} data-size={size}>
    <header class="page-heading">
      <h1>
        Writing<span class="accent">.</span>
      </h1>
      <p>Notes on agent loops, world models, and ML systems.</p>
    </header>
    <form class="blog-controls" role="search" id="blog-filters">
      <label class="control">
        <span>SEARCH POSTS</span>
        <input
          id="blog-search"
          type="search"
          name="q"
          placeholder="Search titles, topics, and descriptions…"
          autocomplete="off"
        />
      </label>
      <label class="control sort-control">
        <span>SORT BY</span>
        <select id="blog-sort" name="sort">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="title">Title A–Z</option>
        </select>
      </label>
      <noscript>
        <button class="button" type="submit">
          Search
        </button>
        <p>
          Search and filtering require JavaScript. All posts remain available
          below and through pagination.
        </p>
      </noscript>
    </form>
    <nav class="tags" aria-label="Filter posts by topic">
      <a class="tag" href="/blogs.html" data-tag="" aria-current="true">
        All topics
      </a>
      {tags.map((tag) => (
        <a
          class="tag"
          href={`/blogs.html?tag=${encodeURIComponent(tag)}`}
          data-tag={tag}
        >
          {tag}
        </a>
      ))}
    </nav>
    <p class="results-status" id="results-status" role="status">
      {posts.length} posts · page {page} of {Math.max(1, pages)}
    </p>
    <div id="blog-results">
      {visible.map((post) => (
        <PostRow post={post} />
      ))}
    </div>
    <p id="blog-empty" class="empty-state" hidden>
      No posts match your search. Try another topic or clear the filters.
    </p>
    <nav id="blog-pagination" class="pagination" aria-label="Blog pagination">
      {page > 1 && (
        <a href={pageUrl(page - 1)} rel="prev">
          ← Previous
        </a>
      )}
      {pages > 1 &&
        Array.from({ length: pages }, (_, i) => (
          <a
            href={pageUrl(i + 1)}
            aria-current={page === i + 1 ? "page" : undefined}
          >
            {i + 1}
          </a>
        ))}
      {page < pages && (
        <a href={pageUrl(page + 1)} rel="next">
          Next →
        </a>
      )}
    </nav>
    <template id="all-posts">
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </template>
  </div>
  <script>
    import "../scripts/blog.js";
  </script>
</BaseLayout>
