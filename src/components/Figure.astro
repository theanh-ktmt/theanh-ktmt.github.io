---
import { dimensions } from "../utils/images";
interface Props {
  src: string;
  alt: string;
  caption?: string;
  narrow?: boolean;
}
const { src, alt, caption = "", narrow = false } = Astro.props;
---

<figure class:list={["blog-figure", { narrow }]}>
  <img
    src={src}
    alt={alt}
    {...dimensions(src)}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption set:html={caption} />}
</figure>
