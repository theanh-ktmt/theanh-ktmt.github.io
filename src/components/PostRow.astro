---
const { post } = Astro.props;
const { title, description, date, tags, readTime } = post.data;
---

<article
  class="post-row"
  data-post
  data-title={title}
  data-description={description}
  data-date={date.toISOString()}
  data-tags={JSON.stringify(tags)}
>
  <time datetime={date.toISOString()}>
    {date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
      timeZone: "UTC",
    })}
  </time>
  <div>
    <h2>
      <a
        href={`/blogs/${post.id}.html`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {title} <span aria-hidden="true">↗</span>
      </a>
    </h2>
    <p>{description}</p>
    <div class="post-meta">
      <span>{readTime}</span>
      <span aria-hidden="true">/</span>
      {tags.map((tag: string) => (
        <a
          href={`/blogs.html?tag=${encodeURIComponent(tag)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {tag}
        </a>
      ))}
    </div>
  </div>
</article>
